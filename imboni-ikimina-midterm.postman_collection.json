  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Finds loan 1 (2026-10-05, DISBURSED) and loan 2 (2026-10-12) automatically",
          "const isId = v => /^[0-9a-f-]{36}$/.test(v || \"\");",
          "if (!isId(pm.collectionVariables.get(\"loan1Id\")) || !isId(pm.collectionVariables.get(\"loan2Id\"))) {",
          "  pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/loans/all\", (err, res) => {",
          "    if (err) { return; }",
          "    const loans = res.json();",
          "    const l1 = loans.find(l => l.requestDate === \"2026-10-05\" && l.status === \"DISBURSED\");",
          "    const l2 = loans.find(l => l.requestDate === \"2026-10-12\");",
          "    if (l1) { pm.collectionVariables.set(\"loan1Id\", l1.id); }",
          "    if (l2) { pm.collectionVariables.set(\"loan2Id\", l2.id); }",
          "  });",
          "}"
        ]
      }
    }
  ]
