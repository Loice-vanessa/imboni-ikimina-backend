            "type": "text/javascript",
            "exec": [
              "// Finds the spare repayment created by \"E1 (201)\"",
              "pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/repayments/all\", (err, res) => {",
              "  if (err) { return; }",
              "  const spare = res.json().filter(r => r.note === \"Demo instalment\");",
              "  if (spare.length > 0) { pm.collectionVariables.set(\"repaymentId\", spare[spare.length - 1].id); }",
              "  else { pm.collectionVariables.set(\"repaymentId\", \"11111111-1111-1111-1111-111111111111\"); }",
              "});"
            ]
