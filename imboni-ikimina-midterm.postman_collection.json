          "script": {
            "type": "text/javascript",
            "exec": [
              "// Finds the loan created by D1 on futureDate",
              "pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/loans/all\", (err, res) => {",
              "  if (err) { return; }",
              "  const t = res.json().find(l => l.requestDate === pm.collectionVariables.get(\"futureDate\"));",
              "  pm.collectionVariables.set(\"testLoanId\", t ? t.id : \"11111111-1111-1111-1111-111111111111\");",
              "});"
            ]
          }
        }
